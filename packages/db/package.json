{
  "name": "@brightpath/db",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "pnpx ts-node prisma/seed.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:seed": "pnpx dotenv-cli -e ../../.env -- prisma db seed",
    "db:migrate": "pnpx dotenv-cli -e ../../.env -- prisma migrate dev",
    "db:push": "pnpx dotenv-cli -e ../../.env -- prisma db push",
    "db:reset": "pnpx dotenv-cli -e ../../.env -- prisma migrate reset",
    "db:migrate-deploy": "pnpx dotenv-cli -e ../../.env -- prisma migrate deploy",
    "db:migrate-test": "pnpx dotenv-cli -e ../../.env.test -- prisma migrate deploy",
    "db:studio": "pnpx dotenv-cli -e ../../.env -- prisma studio",
    "build": "pnpm db:generate && npx tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@brightpath/typescript-config": "workspace:*",
    "prisma": "^6.6.0"
  }
}
