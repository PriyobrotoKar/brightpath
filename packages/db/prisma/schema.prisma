// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  STUDENT
}

enum MerchantStatus {
  IN_BANK_VALIDATION
  BANK_VALIDATION_FAILED
  IN_BENE_CREATION
  BENE_CREATION_FAILED
  IN_KYC_REVIEW
  ACTION_REQUIRED
  ACTIVE
  ON_HOLD
  BLOCKED
  DELETED
}

enum PaymentPlan {
  ONETIME
  FREE
  RECURRING
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

enum CourseType {
  COHORT
  RECORDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum AccessType {
  EVERYONE
  INVITE_ONLY
}

enum Status {
  ARCHIVED
  DRAFT
  PUBLISHED
}

enum SubmissionType {
  FILE_UPLOAD
  FORM_SUBMISSION
}

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  DISABLED
  PENDING_DELETION
}

enum SubscriptionStatus {
  ACTIVE
  HALTED
  CANCELLED
  COMPLETED
}

enum VideoProgressStatus {
  NOT_STARTED
  IN_QUEUE
  PROCESSING
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum Currency {
  INR
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  role           Role     @default(CREATOR)
  profilePicture String?
  bio            String?
  links          String[]
  phone          String?

  courses       Course[]
  accountStatus AccountStatus @default(UNVERIFIED)
  subscription  Subscription?
  merchant      Merchant?
  enrollments   Enrollment[]
  orders        Order[]
  videosWatched Video[]
  docsRead      Document[]
  comments      Comment[]
  likedComments Comment[]     @relation("UserLikedComment")

  isOnboardingFinished Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Merchant {
  id         String         @id @default(cuid())
  name       String
  logo       String
  slug       String
  status     MerchantStatus @default(IN_BENE_CREATION)
  merchantId String         @unique

  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                 String             @id @default(cuid())
  plan               Plan
  status             SubscriptionStatus
  subscriptionId     String             @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  tagline            String?
  description        String?
  tags               String[]
  thumbnails         String[]
  logo               String?
  isPublished        Boolean     @default(false)
  type               CourseType  @default(RECORDED)
  level              CourseLevel
  startAt            DateTime?
  endAt              DateTime?
  accessType         AccessType  @default(EVERYONE)
  accessDuration     Int?
  enrollmentDeadline DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  pricing     Pricing?
  Session     Session[]
  Module      Module[]
  enrollments Enrollment[]
  orders      Order[]
}

model Module {
  id          String @id @default(cuid())
  name        String
  status      Status @default(DRAFT)
  duration    Int    @default(0)
  order       Int
  lessonCount Int    @default(0)

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Document   Document[]
  Video      Video[]
  Assignment Assignment[]
}

model Document {
  id       String @id @default(cuid())
  name     String
  content  String
  duration Int

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  completedBy User[]
  comments    Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id          String              @id @default(cuid())
  name        String
  description String?
  source      String?
  duration    Int
  thumbnail   String?
  status      VideoProgressStatus @default(NOT_STARTED)

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  completedBy User[]
  comments    Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id             String         @id @default(cuid())
  name           String
  description    String?
  dueAt          DateTime?
  submissionType SubmissionType @default(FILE_UPLOAD)

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id          String   @id @default(cuid())
  name        String
  description String?
  startAt     DateTime
  endAt       DateTime
  duration    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  RecurringDetails RecurringDetails?
}

model RecurringDetails {
  id        String   @id @default(cuid())
  dayOfWeek Int
  rrule     String
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String  @unique
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(cuid())
  content String

  commentBy       User   @relation(fields: [commentByUserId], references: [id], onDelete: Cascade)
  commentByUserId String

  likedBy User[] @relation("UserLikedComment")

  replies   Comment[] @relation("ParentChildReply")
  replyTo   Comment?  @relation("ParentChildReply", fields: [replyToId], references: [id], onDelete: Cascade)
  replyToId String?

  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId String?

  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pricing {
  id              String        @id @default(cuid())
  price           Decimal
  paymentPlan     PaymentPlan
  discountEnabled Boolean       @default(false)
  discountValue   Decimal?
  discountType    DiscountType?

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String @unique

  coupons Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountValue Decimal
  discountType  DiscountType
  isActive      Boolean      @default(true)
  expiresAt     DateTime?

  pricing   Pricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  pricingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id     String           @id @default(cuid())
  status EnrollmentStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id])
  userId String

  course   Course @relation(fields: [courseId], references: [id])
  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model Order {
  id             String        @id @default(cuid())
  status         OrderStatus   @default(PENDING)
  currency       Currency      @default(INR)
  originalAmount Decimal
  totalAmount    Decimal
  discount       Decimal?
  discountType   DiscountType?
  discountValue  Decimal?
  taxPercentage  Decimal?
  taxAmount      Decimal?
  orderId        String        @unique
  vendorOrderId  String        @unique

  user   User   @relation(fields: [userId], references: [id])
  userId String

  course   Course @relation(fields: [courseId], references: [id])
  courseId String

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id       String        @id @default(cuid())
  status   PaymentStatus @default(PENDING)
  amount   Decimal
  currency Currency      @default(INR)

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
