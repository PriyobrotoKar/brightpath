// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  STUDENT
}

enum PaymentPlan {
  ONETIME
  FREE
  RECURRING
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

enum CourseType {
  COHORT
  RECORDED
}

enum AccessType {
  EVERYONE
  INVITE_ONLY
}

enum Status {
  ARCHIVED
  DRAFT
  PUBLISHED
}

enum SubmissionType {
  FILE_UPLOAD
  FORM_SUBMISSION
}

enum VideoProgressStatus {
  NOT_STARTED
  IN_QUEUE
  PROCESSING
  COMPLETED
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  name           String?
  role           Role    @default(CREATOR)
  profilePicture String?

  courses Course[]

  isOnboardingFinished Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Course {
  id                 String     @id @default(cuid())
  name               String
  description        String?
  tags               String[]
  thumbnails         String[]
  logo               String?
  isPublished        Boolean    @default(false)
  type               CourseType @default(RECORDED)
  startAt            DateTime?
  endAt              DateTime?
  accessType         AccessType @default(EVERYONE)
  accessDuration     Int?
  enrollmentDeadline DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  pricing Pricing?
  Session Session[]
  Module  Module[]
}

model Module {
  id          String @id @default(cuid())
  name        String
  status      Status @default(DRAFT)
  duration    Int    @default(0)
  order       Int
  lessonCount Int    @default(0)

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Document   Document[]
  Video      Video[]
  Assignment Assignment[]
}

model Document {
  id       String @id @default(cuid())
  name     String
  content  String
  duration Int

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id          String              @id @default(cuid())
  name        String
  description String?
  source      String?
  duration    Int
  thumbnail   String?
  status      VideoProgressStatus @default(NOT_STARTED)

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id             String         @id @default(cuid())
  name           String
  description    String?
  dueAt          DateTime?
  submissionType SubmissionType @default(FILE_UPLOAD)

  module   Module @relation(fields: [moduleId], references: [id])
  moduleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id          String   @id @default(cuid())
  name        String
  description String?
  startAt     DateTime
  endAt       DateTime
  duration    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  RecurringDetails RecurringDetails?
}

model RecurringDetails {
  id        String   @id @default(cuid())
  dayOfWeek Int
  rrule     String
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String  @unique
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pricing {
  id              String        @id @default(cuid())
  price           Decimal
  paymentPlan     PaymentPlan
  discountEnabled Boolean       @default(false)
  discountValue   Decimal?
  discountType    DiscountType?

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String @unique

  coupons Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountValue Decimal
  discountType  DiscountType
  isActive      Boolean      @default(true)
  expiresAt     DateTime?

  pricing   Pricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  pricingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
